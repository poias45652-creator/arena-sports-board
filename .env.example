# Documentation only. Set real values in Render > Environment.
# Existing deployments: retain the existing DATABASE_URL and secrets.
NODE_VERSION=24
DATABASE_URL=
TZ_BINDING_KEY=
ARENA_SETUP_TOKEN=
# Optional: set only for a custom public domain, with no trailing path.
# When blank, Render's RENDER_EXTERNAL_URL is used automatically.
APP_ORIGIN=

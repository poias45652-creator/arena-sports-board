# Server-only base64-encoded 32-byte AES key; set as a Sites secret.
TZ_BINDING_KEY=

# Cloudflare Turnstile: private server-side verification key
TURNSTILE_SECRET=

# Optional background sync; configure only after selecting the scheduler.
# Generate a random server-only token of at least 32 characters; never expose it to clients.
BASEBALL_SYNC_TOKEN=
# Scheduler-only destination, not a browser setting.
BASEBALL_SYNC_URL=https://arena-sports-board.poias45652.chatgpt.site/api/international-sync

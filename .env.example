# Existing Render PostgreSQL connection; do not upload the real value.
DATABASE_URL=
# Base64-encoded 32 random bytes. Keep unchanged after the first deployment.
TZ_BINDING_KEY=
# Your platform administrator username; verified upstream before granting access.
PLATFORM_ADMIN_USERNAME=
APP_ORIGIN=https://arena-sports-board.onrender.com
# Optional Turnstile. Configure both; allow the Render hostname in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Optional existing external scheduler; no scheduler is created by this package.
BASEBALL_SYNC_TOKEN=
BASEBALL_SYNC_URL=https://arena-sports-board.onrender.com/api/international-sync
